# Required for LLM personas/reviews. Either provider works; you can mix.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override default models
PR_REVIEW_MODEL=claude-opus-4-7
PR_PERSONA_MODEL=claude-sonnet-4-6
PR_META_MODEL=gpt-5
PR_EMBED_MODEL=text-embedding-3-large

# Optional: where to put scraped/derived data (defaults to ./data)
PR_DATA_DIR=./data
